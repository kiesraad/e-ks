#!/bin/bash
# Enrols a security key for the CSB login and prints the CSB_WEBAUTHN_USERS
# entry for it. Run by the administrator with the committee member present to
# plug in their key and enter its PIN. Talks to the key directly through
# libfido2 (fido2-cred); nothing is sent to e-KS. See docs/csb-enrolment.md.

set -euo pipefail

usage() {
    echo "Usage: bin/enrol_csb_user <username> <rp-id> [device]" >&2
    echo >&2
    echo "  username  1-64 letters, digits, '.', '-', '_' or '@'" >&2
    echo "  rp-id     host of CSB_WEBAUTHN_ORIGIN, e.g. csb.example.nl" >&2
    echo "  device    authenticator path from 'fido2-token -L'; optional when" >&2
    echo "            exactly one is attached" >&2
    exit 1
}

# fido2-cred speaks standard base64; the configuration line uses base64url
# without padding, which has no +, / or = to upset shells, YAML or .env files.
to_base64url() {
    tr '+/' '-_' | tr -d '=\n'
}

[ $# -ge 2 ] && [ $# -le 3 ] || usage
username=$1
rp_id=$2
device=${3:-}

if ! [[ "$username" =~ ^[A-Za-z0-9._@-]{1,64}$ ]]; then
    echo "invalid username: $username" >&2
    usage
fi

for tool in fido2-cred fido2-token; do
    command -v "$tool" > /dev/null || { echo "$tool not found: install libfido2 (fido2-tools)" >&2; exit 1; }
done

if [ -z "$device" ]; then
    devices=$(fido2-token -L | sed 's/: vendor=.*//')
    if [ "$(printf '%s\n' "$devices" | grep -c .)" -ne 1 ]; then
        echo "attach exactly one security key or pass its device path:" >&2
        fido2-token -L >&2
        exit 1
    fi
    device=$devices
fi

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

# fido2-cred -M input: client data hash, relying party id, user name, user id.
# The hash only matters to the key itself, so a random value does. The user
# id (the WebAuthn user handle) is random too and goes into the entry.
user_handle=$(head -c 32 /dev/urandom | base64)
{
    head -c 32 /dev/urandom | base64
    echo "$rp_id"
    echo "$username"
    echo "$user_handle"
} > "$workdir/param"

echo "Enter the key's PIN when prompted, then touch the key." >&2
# No -v on -M: that requests built-in user verification (biometrics), which
# PIN-only keys reject. A key with a PIN set asks for it anyway, and -V -v
# refuses the credential unless the PIN was verified.
fido2-cred -M -i "$workdir/param" "$device" | fido2-cred -V -v -o "$workdir/cred"

credential_id=$(head -n 1 "$workdir/cred" | to_base64url)
public_key=$(sed '1d; /^-----/d' "$workdir/cred" | to_base64url)

echo "${username}:$(printf '%s' "$user_handle" | to_base64url):${credential_id}:${public_key}"
