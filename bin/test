#!/bin/bash

set -euo pipefail

export MEMORY_SERVE_QUIET=1

./bin/esbuild --bundle frontend/index.ts \
    --outdir=frontend/static \
    --minify \
    --sourcemap \
    --define:IS_PRODUCTION=true \
    --loader:.woff2=file \
    --loader:.svg=file \
    --public-path=/static/

cargo build \
    --locked \
    --no-default-features \
    --features memory-serve,fixtures,dev-features,tvs-mock \
    --release \
    --bin eks

pushd playwright
    docker compose build --quiet

    # The playwright service waits for the application's healthcheck, so a
    # failure here is either a broken app or a failing test; either way the
    # application log is what explains it.
    if ! docker compose run --rm --quiet-pull --quiet-build playwright; then
        docker compose logs --no-color application
        docker compose down --remove-orphans --volumes
        exit 1
    fi

    docker compose down --remove-orphans --volumes
popd
