#!/bin/bash

set -euo pipefail

export MEMORY_SERVE_QUIET=1

FULL=false
for arg in "$@"; do
    case "$arg" in
        -a|--all|--full) FULL=true ;;
        -h|--help)
            echo "Usage: bin/check [--full]"
            echo
            echo "  --full  Run the Rust checks for the whole workspace with"
            echo "          --all-features, build the API docs, and run the"
            echo "          dylint libraries."
            exit 0
            ;;
        *)
            echo "Unknown argument: $arg" >&2
            echo "Usage: bin/check [--full]" >&2
            exit 1
            ;;
    esac
done

echo "==> Rust checks"
if [ "$FULL" = true ]; then
    cargo check --locked --workspace --all-features
    cargo +nightly fmt --all -- --config imports_granularity="Crate"
    cargo clippy --locked --all-targets --workspace --all-features -- -D warnings
    cargo test --locked --workspace --all-features
    cargo doc --locked --workspace --no-deps --all-features --document-private-items
    cargo dylint --all -- --locked
else
    cargo +nightly fmt --all -- --config imports_granularity="Crate"
    cargo clippy --locked --all-targets --features development -- -D warnings
    cargo test --locked --features development
fi

# typescript
echo "==> Typescript checks"
./bin/biome check --fix ./frontend
./bin/biome check --fix ./playwright/tests

# html
echo "==> Html checks"
# fix for devs that use docker rootless
if docker info -f '{{.SecurityOptions}}' | grep -q rootless; then
  DOCKER_USER="0:0"
else
  DOCKER_USER="$(id -u):$(id -g)"
fi
docker run --rm -v ./src:/work/templates --user "$DOCKER_USER" djlint

# generic
./bin/check_newline
./bin/update_locales
